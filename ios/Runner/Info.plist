<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wimz App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wimz_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is needed for video streaming</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WIM-Z needs microphone access to record voice commands for your dog</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>WIM-Z needs access to your photo library to save photos of your dog.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>WIM-Z needs permission to save photos to your library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WIM-Z does not track your location. This permission is required by the video streaming library to detect the local network for connecting to your robot.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- WIM-Z talks plain HTTP/WS to the robot over its local AP (no TLS on the
	     Pi). NSAllowsLocalNetworking permits cleartext to private/local
	     addresses (e.g. http://192.168.4.1:8000/video/feed) WITHOUT disabling
	     ATS globally — relay traffic stays HTTPS-only. A blocked cleartext
	     request otherwise looks like the video "connecting forever". -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS 14+ prompts for local-network access when reaching LAN devices. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>WIM-Z connects directly to your robot over your local network or its WiFi hotspot to stream video and send commands.</string>
</dict>
</plist>
